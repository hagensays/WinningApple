<Window x:Class="HSScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:HSScanner.Infrastructure"
        Title="HSScanner"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource HsBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HsHeaderBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource HsAccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="HS" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="HSScanner" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Read-only Laufwerksinventur für Lösch- und Aufbewahrungsplanung"
                               Foreground="#B9C3D6" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Background="{DynamicResource HsHeaderSurfaceBrush}"
                        CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionTextBlock" Text="{x:Static infra:VersionInfo.DisplayVersion}" Foreground="#D9E0EC" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,16,24,12" Style="{StaticResource HsCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Scan-Ziel" Style="{StaticResource HsSectionTitleTextStyle}" Margin="0,0,0,10" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DriveComboBox"
                                  Style="{StaticResource HsComboBoxStyle}"
                                  Margin="0,0,10,0"
                                  SelectionChanged="DriveComboBox_SelectionChanged" />
                        <TextBox x:Name="SourcePathTextBox"
                                 Grid.Column="1"
                                 Style="{StaticResource HsTextBoxStyle}" />
                        <Button Grid.Column="2"
                                Content="Ordner wählen…"
                                Style="{StaticResource HsSecondaryButtonStyle}"
                                Margin="10,0,0,0"
                                Click="BrowseButton_Click" />
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Margin="0,9,0,0"
                               Style="{StaticResource HsSecondaryTextStyle}"
                               Text="Ganzes Laufwerk oder einzelnen Stammordner scannen. HSScanner liest nur Metadaten; Quelldateien werden nicht verändert." />
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Planungsfilter" Style="{StaticResource HsSectionTitleTextStyle}" Margin="0,0,0,10" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="Stichtag:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="CutoffYearsTextBox"
                                 Width="54"
                                 Text="11"
                                 TextAlignment="Center"
                                 Style="{StaticResource HsTextBoxStyle}" />
                        <TextBlock Text="Jahre" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <CheckBox x:Name="IncludeHiddenCheckBox" IsChecked="True"
                                  Content="Versteckte Elemente einbeziehen" Margin="0,0,0,6" />
                        <CheckBox x:Name="IncludeSystemCheckBox" IsChecked="True"
                                  Content="Systemelemente einbeziehen" Margin="0,0,0,6" />
                        <CheckBox x:Name="SkipReparseCheckBox" IsChecked="True"
                                  Content="Reparse Points überspringen (empfohlen)" />
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource HsWarningBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Der Stichtag markiert nur Prüfbedarf. Er ist keine rechtliche Löschentscheidung." />
                </Grid>

                <Border Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Margin="0,16,0,0"
                        Padding="12"
                        CornerRadius="6"
                        Background="{DynamicResource HsAccentSoftBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ausgabe" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HsPrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="OutputFolderText"
                                   Grid.Column="1"
                                   Margin="12,0"
                                   Foreground="{DynamicResource HsSecondaryTextBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="nur neben der EXE"
                                   Foreground="{DynamicResource HsAccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="24,0,24,12"
                Style="{StaticResource HsCardStyle}"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ScanButton"
                            Style="{StaticResource HsPrimaryButtonStyle}"
                            Content="Scan starten"
                            Click="ScanButton_Click" />
                    <Button x:Name="CancelButton"
                            Content="Abbrechen"
                            Style="{StaticResource HsSecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            IsEnabled="False"
                            Click="CancelButton_Click" />
                    <Button x:Name="ExportButton"
                            Content="Excel exportieren"
                            Style="{StaticResource HsSecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            IsEnabled="False"
                            Click="ExportButton_Click" />
                </StackPanel>

                <ProgressBar x:Name="ScanProgressBar"
                             Grid.Column="1"
                             Style="{StaticResource HsProgressBarStyle}"
                             Margin="20,0"
                             IsIndeterminate="False"
                             VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ordner " Foreground="{DynamicResource HsSecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="FolderCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                    <TextBlock Text="Dateien " Foreground="{DynamicResource HsSecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="FileCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                    <TextBlock Text="Prüffälle " Foreground="{DynamicResource HsSecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="OldFileCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                    <TextBlock Text="Fehler " Foreground="{DynamicResource HsSecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="ErrorCountText" Text="0" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="24,0,24,12"
                Style="{StaticResource HsCardStyle}"
                Padding="0">
            <TabControl BorderThickness="0" Background="Transparent">
                <TabItem Header="Übersicht">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <UniformGrid Columns="4" Margin="0,0,0,20">
                                <Border Margin="0,0,10,0"
                                        Padding="16"
                                        Background="{DynamicResource HsBackgroundBrush}"
                                        BorderBrush="{DynamicResource HsBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="Ordner" Style="{StaticResource HsSecondaryTextStyle}" />
                                        <TextBlock x:Name="SummaryFoldersText" Text="0" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HsPrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,10,0"
                                        Padding="16"
                                        Background="{DynamicResource HsBackgroundBrush}"
                                        BorderBrush="{DynamicResource HsBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="Dateien" Style="{StaticResource HsSecondaryTextStyle}" />
                                        <TextBlock x:Name="SummaryFilesText" Text="0" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HsPrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,10,0"
                                        Padding="16"
                                        Background="{DynamicResource HsBackgroundBrush}"
                                        BorderBrush="{DynamicResource HsBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="Gesamtgröße" Style="{StaticResource HsSecondaryTextStyle}" />
                                        <TextBlock x:Name="SummarySizeText" Text="0 B" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HsPrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="16"
                                        Background="{DynamicResource HsBackgroundBrush}"
                                        BorderBrush="{DynamicResource HsBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="Älter als Stichtag" Style="{StaticResource HsSecondaryTextStyle}" />
                                        <TextBlock x:Name="SummaryOldText" Text="0" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HsPrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="1"
                                    Padding="16"
                                    Background="{DynamicResource HsAccentSoftBrush}"
                                    CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="Was der Excel-Export vorbereitet"
                                               Style="{StaticResource HsSectionTitleTextStyle}"
                                               Margin="0,0,0,8" />
                                    <TextBlock TextWrapping="Wrap"
                                               Style="{StaticResource HsSecondaryTextStyle}"
                                               Text="Übersicht • Ordner mit Level 0/1/2/… und Parent-ID • direkte und rekursive Datei-/Größenwerte • Stichtagswerte • leere Felder für Verantwortliche, Entscheidung, Begründung, Freigabe, Löschdatum und Nachweis • vollständige Dateiliste • Fehlerprotokoll." />
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="2"
                                       x:Name="SummaryStatusText"
                                       Margin="0,16,0,0"
                                       Text="Noch kein Scan durchgeführt."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource HsPrimaryTextBrush}" />
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Ordner">
                    <DataGrid x:Name="FoldersGrid"
                              Style="{StaticResource HsDataGridStyle}"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                            <DataGridTextColumn Header="Parent" Binding="{Binding ParentId}" Width="80" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70" />
                            <DataGridTextColumn Header="Ordner" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="Relativer Pfad" Binding="{Binding RelativePath}" Width="2*" />
                            <DataGridTextColumn Header="Dateien direkt" Binding="{Binding DirectFileCount}" Width="105" />
                            <DataGridTextColumn Header="Dateien gesamt" Binding="{Binding RecursiveFileCount}" Width="110" />
                            <DataGridTextColumn Header="Prüffälle" Binding="{Binding OlderThanCutoffFileCount}" Width="100" />
                            <DataGridTextColumn Header="Größe gesamt (Bytes)" Binding="{Binding RecursiveSizeBytes}" Width="135" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Dateien">
                    <DataGrid x:Name="FilesGrid"
                              Style="{StaticResource HsDataGridStyle}"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr." Binding="{Binding Sequence}" Width="80" />
                            <DataGridTextColumn Header="Level" Binding="{Binding FolderLevel}" Width="65" />
                            <DataGridTextColumn Header="Dateiname" Binding="{Binding Name}" Width="240" />
                            <DataGridTextColumn Header="Erw." Binding="{Binding Extension}" Width="70" />
                            <DataGridTextColumn Header="Relativer Pfad" Binding="{Binding RelativePath}" Width="2*" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding SizeBytes}" Width="110" />
                            <DataGridTextColumn Header="Erstellt" Binding="{Binding CreationTime}" Width="145" />
                            <DataGridTextColumn Header="Geändert" Binding="{Binding LastWriteTime}" Width="145" />
                            <DataGridTextColumn Header="Referenzdatum" Binding="{Binding ReferenceDate}" Width="145" />
                            <DataGridCheckBoxColumn Header="Älter als Stichtag" Binding="{Binding OlderThanCutoff}" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Fehler / nicht lesbar">
                    <DataGrid x:Name="ErrorsGrid"
                              Style="{StaticResource HsDataGridStyle}"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="145" />
                            <DataGridTextColumn Header="Vorgang" Binding="{Binding Operation}" Width="180" />
                            <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="2*" />
                            <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="4"
                Background="{DynamicResource HsSurfaceBrush}"
                BorderBrush="{DynamicResource HsBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Bereit"
                           FontSize="12"
                           Foreground="{DynamicResource HsSecondaryTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="Read-only · HSSuite"
                           FontSize="12"
                           Foreground="{DynamicResource HsMutedTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
